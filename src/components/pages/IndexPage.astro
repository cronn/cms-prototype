---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCurrentLocale, getLocalizedData } from "../../i18n/utils";
import PageTitle from "../ui/PageTitle.astro";

const currentLocale = getCurrentLocale(Astro.currentLocale);
const { index } = getLocalizedData({ currentLocale });
---

<BaseLayout title={index.title} ogDescription={index.title}>
  <PageTitle title={`🧑‍🚀 ${index.primaryHeading}`} />
  <p>
    {index.paragraphOne}
  </p>
  <p>
    {index.paragraphTwo}
  </p>
  <p>{index.paragraphThree}</p>

  <p>
    {index.paragraphFour}
  </p>
</BaseLayout>
