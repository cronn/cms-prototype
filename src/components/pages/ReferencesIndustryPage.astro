---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import { getCurrentLocale, getLocalizedData } from "../../i18n/utils";
import { dynamicImageImport } from "../../utils/dynamicImageImport";
import PageTitle from "../../components/ui/PageTitle.astro";
import FilterLinkList from "../ui/FilterLinkList.astro";
import type { CollectionEntry } from "astro:content";
import type { TReferenceIndustry } from "../../types/data";

interface Props {
  industryFilterOptions: TReferenceIndustry[];
  references: CollectionEntry<"references">[];
}

const currentLocale = getCurrentLocale(Astro.currentLocale);
const { references: referenceTexts } = getLocalizedData({ currentLocale });

const { industryFilterOptions, references } = Astro.props;
---

<BaseLayout title={referenceTexts.title} ogDescription={referenceTexts.title}>
  <PageTitle title={referenceTexts.title} />
  <FilterLinkList
    filterOptions={industryFilterOptions}
    linkPath="referenzen"
    sectionHeadline={referenceTexts.categories}
  />
  <section>
    <ul class="grid grid-cols-3 gap-6">
      {
        references.map((reference) => (
          <li class="max-w-sm overflow-hidden rounded-sm shadow-lg hover:shadow-xl">
            <a
              href={getRelativeLocaleUrl(
                currentLocale,
                `referenzen/${reference.id.split("/")[1]}`,
              )}
            >
              <Image
                class="max-h-40 w-full rounded-none object-cover"
                src={dynamicImageImport[reference.data.titleImage]()}
                alt={reference.data.title}
                width={350}
                height={200}
              />
              <div class="px-6 py-4">
                {reference.data.industry && (
                  <p class="mb-0 text-sm text-gray-600">
                    {referenceTexts.industryEnum[reference.data.industry]}
                  </p>
                )}
                <h2 class="mb-2 text-xl font-bold">{reference.data.title}</h2>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
