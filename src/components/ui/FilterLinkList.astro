---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCurrentLocale, getLocalizedData } from "../../i18n/utils";
import type { TReferenceIndustry } from "../../types/data";

const currentLocale = getCurrentLocale(Astro.currentLocale);
const { references: referencesTexts } = getLocalizedData({ currentLocale });
interface Props {
  linkPath: string;
  filterOptions: TReferenceIndustry[];
  sectionHeadline?: string;
}

const { linkPath, filterOptions, sectionHeadline } = Astro.props;
---

{
  sectionHeadline && (
    <p class="mb-2 text-center text-xl uppercase">{sectionHeadline}</p>
  )
}
<ul class="mb-16 flex justify-center gap-2">
  {
    filterOptions.map((option) => (
      <li>
        <a
          class="rounded-sm bg-blue-500 p-2 text-gray-50 capitalize hover:bg-blue-600 hover:text-gray-50"
          href={encodeURI(
            getRelativeLocaleUrl(
              currentLocale,
              `${linkPath}/${encodeURIComponent(option.toLowerCase())}`,
            ),
          )}
        >
          {referencesTexts.industryEnum[option]}
        </a>
      </li>
    ))
  }
</ul>
